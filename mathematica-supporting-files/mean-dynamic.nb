               RowBox[{"pvars", "*", 
                RowBox[{"L", ".", "pvars"}]}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"0", "\[LessEqual]", 
                RowBox[{"p", "[", "i", "]"}], "\[LessEqual]", "1"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}], ",", "pvars", ",", "Reals"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Normalize", "[", 
