         "pvars", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "x", "]"}], "!=", "n"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             
             RowBox[{"\"\<The dimension of the population distribution \
provided does not match the number of strategies\>\"", ",", "18", ",", 
              "Red"}], "]"}], "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Or", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"x", ",", "1"}], "]"}], ">", "0"}], ",", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"x", ",", "1."}], "]"}], ">", "0"}]}], "]"}], ",", 
          RowBox[{"Return", "[", "x", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"pvars", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"p", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
