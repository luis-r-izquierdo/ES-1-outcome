      RowBox[{"N", "@", "xv"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LMatrix", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExpectedTimeUntilBreakUp", "[", 
         RowBox[{"#1", ",", "#2", ",", "\[Epsilon]", ",", "\[Delta]"}], "]"}],
         "&"}], ",", "strategies", ",", "strategies", ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Lij = \>\"", ",", 
