       RowBox[{"MatrixForm", "@", "LMatrix"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Distribution in the pool corresponding to xv : \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"PoolFromPop", "[", 
         RowBox[{
         "xv", ",", "strategies", ",", "\[Epsilon]", ",", "\[Delta]"}], "]"}],
         ",", "6"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FMatrix", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"F", "[", 
