   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"initial", " ", "point"}], ",", " ", 
     RowBox[{"whole", " ", "population"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xv", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0.25", ",", "0.25", ",", "0.25", ",", 
