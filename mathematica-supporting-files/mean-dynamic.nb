   3.9587891399603167`*^9, 3.958789243431324*^9}, {3.9587892916444187`*^9, 
   3.95878933479812*^9}, {3.958789399039517*^9, 3.9587894719740257`*^9}, {
   3.958789535984682*^9, 3.958789542930447*^9}, {3.958789735224752*^9, 
   3.958789854780471*^9}, {3.958789931593004*^9, 3.958789933316463*^9}, {
   3.958790613657771*^9, 3.958790713111376*^9}, {3.9587907551580763`*^9, 
   3.958790791785624*^9}, {3.9587908906894217`*^9, 3.958790894322489*^9}, {
   3.958790963907043*^9, 3.9587909727785482`*^9}, {3.958791041644082*^9, 
   3.958791071369722*^9}, {3.9587911571383057`*^9, 3.958791159637206*^9}, {
