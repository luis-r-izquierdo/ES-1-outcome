      RowBox[{
       RowBox[{"Fx", "[", 
        RowBox[{
        "xv", ",", "strategies", ",", "\[Epsilon]", ",", "\[Delta]", ",", 
         "payoffs"}], "]"}], ",", "6"}], "]"}]}], "]"}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
