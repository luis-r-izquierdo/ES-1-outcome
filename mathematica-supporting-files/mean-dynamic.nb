   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "set", " ", "of", " ", "strategies", " ", "you", " ", "want", " ", "to", " ",
      "include"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"strategies", "=", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "leaver1", ",", "\[IndentingNewLine]", "leaver2", ",", 
       "\[IndentingNewLine]", "leaver3", ",", "\[IndentingNewLine]", "grim", ",",
        "\[IndentingNewLine]", "WSLS", ",", "\[IndentingNewLine]", "TFT", ",",
        "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"c", ",", "c", ",", "d", ",", "c", ",", "c"}], "}"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"initial", " ", "point"}], ",", " ", 
     RowBox[{"whole", " ", "population"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xv", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0.25", ",", "0.25", ",", "0.25", ",", 
         "0.25"}], "}"}], ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "parameteres", " ", "for", " ", "the", " ", "solution", " ", 
     "trajectory"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMax", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tolerance", "=", 
     RowBox[{"10.", "^", 
      RowBox[{"-", "6"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"END", " ", "PARAMETERS"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Total", "[", "xv", "]"}], "!=", "1."}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Total[xv] != 1\>\"", ",", "18", ",", "Red"}], "]"}], 
       "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Map", "[", 
    RowBox[{"StrategyName", ",", "strategies"}], "]"}], "\[IndentingNewLine]", 
