      "the", " ", "composition", " ", "in", " ", "the", " ", "population", " ",
      "x"}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PoolFromPop", "[", 
      RowBox[{
       RowBox[{"x_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}], ")"}]}], ",", 
       "strategies_List", ",", "\[Epsilon]_", ",", "\[Delta]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "L", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"L", "=", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ExpectedTimeUntilBreakUp", "[", 
             RowBox[{"#1", ",", "#2", ",", "\[Epsilon]", ",", "\[Delta]"}], 
             "]"}], "&"}], ",", "strategies", ",", "strategies", ",", "1"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"PoolFromPop", "[", 
         RowBox[{
         "x", ",", "strategies", ",", "\[Epsilon]", ",", "\[Delta]", ",", 
          "L"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PoolFromPop", "[", 
      RowBox[{
       RowBox[{"x_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}], ")"}]}], ",", 
       "strategies_List", ",", "\[Epsilon]_", ",", "\[Delta]_", ",", "L_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
