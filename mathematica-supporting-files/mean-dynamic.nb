 RowBox[{
  RowBox[{"(*", " ", "PARAMETERS", " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "continuation", " ", "probability", " ", "for", " ", "partnerships"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"0.95", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"action", " ", "error", " ", "rate"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Epsilon]", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"0.05", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"probability", " ", "of", " ", "experimentation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]", "=", 
     RowBox[{"Rationalize", "[", 
      RowBox[{"0.05", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"payoffs", "=", 
     RowBox[{"{", 
      RowBox[{"3", ",", "0", ",", "4", ",", "1"}], "}"}]}], ";"}], " ", 
