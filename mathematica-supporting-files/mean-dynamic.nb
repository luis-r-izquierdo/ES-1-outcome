       RowBox[{"x_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{"VectorQ", "[", 
             RowBox[{"#", ",", "NumericQ"}], "]"}], ",", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"#", ",", "NonNegative"}], "]"}]}], "]"}], "&"}], 
         ")"}]}], ",", "strategies_List", ",", "\[Epsilon]_", ",", 
       "\[Delta]_", ",", "\[Mu]_", ",", 
       RowBox[{"payoffs_", ":", 
        RowBox[{"{", 
         RowBox[{"3", ",", "0", ",", "4", ",", "1"}], "}"}]}]}], "]"}], ":=", 
     
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"LMatrix", ",", "FMatrix"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FMatrix", "=", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"F", "[", 
             RowBox[{
             "#1", ",", "#2", ",", "\[Epsilon]", ",", "\[Delta]", ",", 
              "payoffs"}], "]"}], "&"}], ",", "strategies", ",", "strategies",
            ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"LMatrix", "=", 
         RowBox[{"Outer", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ExpectedTimeUntilBreakUp", "[", 
             RowBox[{"#1", ",", "#2", ",", "\[Epsilon]", ",", "\[Delta]"}], 
             "]"}], "&"}], ",", "strategies", ",", "strategies", ",", "1"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ExpectedChange", "[", 
         RowBox[{
         "x", ",", "strategies", ",", "\[Epsilon]", ",", "\[Delta]", ",", 
          "\[Mu]", ",", "LMatrix", ",", "FMatrix"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ExpectedChange", "[", 
      RowBox[{
       RowBox[{"x_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"And", "[", 
           RowBox[{
            RowBox[{"VectorQ", "[", 
             RowBox[{"#", ",", "NumericQ"}], "]"}], ",", 
            RowBox[{"VectorQ", "[", 
             RowBox[{"#", ",", "NonNegative"}], "]"}]}], "]"}], "&"}], 
         ")"}]}], ",", "strategies_List", ",", "\[Epsilon]_", ",", 
       "\[Delta]_", ",", "\[Mu]_", ",", "LMatrix_", ",", "FMatrix_"}], "]"}], 
     ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalPi]", ",", 
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "strategies", "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalPi]", "=", 
         RowBox[{"Fx", "[", 
          RowBox[{
          "x", ",", "strategies", ",", "\[Epsilon]", ",", "\[Delta]", ",", 
           "LMatrix", ",", "FMatrix"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Mu]"}], ")"}], "*", 
          RowBox[{"ReplicatorMS", "[", 
           RowBox[{"x", ",", "\[CapitalPi]"}], "]"}]}], "+", 
         RowBox[{"\[Mu]", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"1", "/", "n"}], ",", "n"}], "]"}], "-", "x"}], 
           ")"}]}]}]}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"EC", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "m"}], ")"}], "*", 
           RowBox[{"ReplicatorMS", "[", 
            RowBox[{"x", ",", "\[CapitalPi]"}], "]"}]}], "+", 
          RowBox[{"m", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"1", "/", "n"}], ",", "n"}], "]"}], "-", "x"}], 
            ")"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Normalize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "/", "n"}], "+", "EC"}], ",", "Total"}], "]"}], "-", 
         
         RowBox[{"1", "/", "n"}]}]}], "*)"}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "DYNAMICS", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ReplicatorMS", "[", 
      RowBox[{"x_", ",", "\[CapitalPi]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"avgPayoff", "=", 
         RowBox[{"x", ".", "\[CapitalPi]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Piecewise", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1", "/", "avgPayoff"}], ",", 
             RowBox[{"avgPayoff", ">", "0"}]}], "}"}], "}"}], ",", "0"}], 
         "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "*", "\[CapitalPi]"}], ")"}], "-", 
          RowBox[{"avgPayoff", "*", "x"}]}], ")"}]}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Replicator", "[", 
       RowBox[{"x_", ",", "\[CapitalPi]_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "*", "\[CapitalPi]"}], ")"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", ".", "\[CapitalPi]"}], ")"}], " ", "x"}]}]}], ";"}], 
    "*)"}]}]}]], "Input",
